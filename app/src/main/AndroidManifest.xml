<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FamilyNotes">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FamilyNotes.Splash"
            android:lockTaskMode="if_whitelisted"
            android:keepScreenOn="true"
            android:configChanges="orientation|keyboardHidden|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Required: set your sentry.io project identifier (DSN) -->
        <meta-data
            android:name="io.sentry.dsn"
            android:value="https://bea6932cbd3951257b2fcb41cd906a76@o4509121428193280.ingest.us.sentry.io/4510640032972800"
        />
        <!-- Kiosk/shared device: limit PII and crash attachments that could capture on-screen notes -->
        <meta-data
            android:name="io.sentry.send-default-pii"
            android:value="false"
        />
        <meta-data
            android:name="io.sentry.traces.user-interaction.enable"
            android:value="false"
        />
        <meta-data
            android:name="io.sentry.breadcrumbs.user-interaction"
            android:value="false"
        />
        <meta-data
            android:name="io.sentry.attach-screenshot"
            android:value="false"
        />
        <meta-data
            android:name="io.sentry.attach-view-hierarchy"
            android:value="false"
        />
        <!-- Lower trace volume for cost; still enough for latency/error correlation -->
        <meta-data
            android:name="io.sentry.traces.sample-rate"
            android:value="0.1"
        />
        <!-- Profiling off by default (0); enable in a build flavor if investigating perf -->
        <meta-data
            android:name="io.sentry.traces.profiling.session-sample-rate"
            android:value="0"
        />
        <meta-data
            android:name="io.sentry.traces.profiling.lifecycle"
            android:value="trace"
        />
        <meta-data
            android:name="io.sentry.traces.profiling.start-on-app-start"
            android:value="false"
        />
        <!-- Session replay captures screen: no ambient sampling; subset of errors only -->
        <meta-data
            android:name="io.sentry.session-replay.on-error-sample-rate"
            android:value="0.2"
        />
        <meta-data
            android:name="io.sentry.session-replay.session-sample-rate"
            android:value="0"
        />
    </application>

</manifest>
